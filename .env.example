# Copy to .env and fill in. The app reads these from the environment; Docker Compose reads .env itself.
# (Spring Boot does not load a .env file on its own: export the values, or set them in your IDE run configuration.)

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/homescapedb
DB_USERNAME=postgres
DB_PASSWORD=choose-a-password

# --- Login tokens ---
# At least 32 characters. If it is empty a random key is used and everyone is logged out on every restart.
JWT_SECRET=

# --- Optional first admin account (both or neither) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Where uploaded photos are stored ---
UPLOAD_DIR=uploads/
